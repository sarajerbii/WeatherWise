{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "frontend-trips-modifs": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ww",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/frontend-trips-modifs",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {"outputHashing": "all"},
            "local": {"fileReplacements": [{"replace": "src/environments/environment.ts", "with": "src/environments/environment.local.ts"}]}
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {"buildTarget": "frontend-trips-modifs:build:production"},
            "local": {"buildTarget": "frontend-trips-modifs:build:local"}
          },
          "defaultConfiguration": "local"
        }
      }
    }
  },
  "cli": {"analytics": false}
}
